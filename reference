import cv2
import numpy as np

# Load MobileNet-SSD model directly into OpenCV
net = cv2.dnn.readNetFromCaffe('MobileNetSSD_deploy.prototxt', 'MobileNetSSD_deploy.caffemodel')

# COCO / MobileNet classes
CLASSES = ["background", "aeroplane", "bicycle", "bird", "boat",
           "bottle", "bus", "car", "cat", "chair", "cow", "diningtable",
           "dog", "horse", "motorbike", "person", "pottedplant", "sheep",
           "sofa", "train", "tvmonitor"]

SUSPECT_CLASSES = ["bottle", "chair", "tvmonitor", "person"]

cap = cv2.VideoCapture(0)
cap.set(cv2.CAP_PROP_FRAME_WIDTH, 640)
cap.set(cv2.CAP_PROP_FRAME_HEIGHT, 480)

def detect_lens_glints(gray_frame):
    _, bright_spots = cv2.threshold(gray_frame, 220, 255, cv2.THRESH_BINARY)
    blurred = cv2.GaussianBlur(bright_spots, (9, 9), 2)
    return cv2.HoughCircles(
        blurred, cv2.HOUGH_GRADIENT, dp=1.2, minDist=20,
        param1=50, param2=15, minRadius=3, maxRadius=25
    )

print("[INFO] Starting OpenCV-only detection system...")

while cap.isOpened():
    ret, frame = cap.read()
    if not ret:
        break

    h, w = frame.shape[:2]
    gray = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)
    risk_score = 0

    # 1. Glint Detection
    circles = detect_lens_glints(gray)
    if circles is not None:
        risk_score += 30
        circles = np.uint16(np.around(circles))
        for i in circles[0, :]:
            cv2.circle(frame, (i[0], i[1]), i[2] + 4, (0, 0, 255), 2)

    # 2. Object Detection via OpenCV DNN
    blob = cv2.dnn.blobFromImage(cv2.resize(frame, (300, 300)), 0.007843, (300, 300), 127.5)
    net.setInput(blob)
    detections = net.forward()

    for i in range(detections.shape[2]):
        confidence = detections[0, 0, i, 2]
        if confidence > 0.4:
            idx = int(detections[0, 0, i, 1])
            label = CLASSES[idx]
            
            box = detections[0, 0, i, 3:7] * np.array([w, h, w, h])
            (startX, startY, endX, endY) = box.astype("int")

            if label in SUSPECT_CLASSES:
                risk_score += 30
                color = (0, 255, 255)
            else:
                color = (0, 255, 0)

            cv2.rectangle(frame, (startX, startY), (endX, endY), color, 2)
            cv2.putText(frame, f"{label}: {confidence:.2f}", (startX, startY - 5),
                        cv2.FONT_HERSHEY_SIMPLEX, 0.5, color, 2)

    # Display status
    cv2.putText(frame, f"Threat Level: {risk_score}%", (20, 30),
                cv2.FONT_HERSHEY_SIMPLEX, 0.7, (0, 255, 0) if risk_score < 40 else (0, 0, 255), 2)

    cv2.imshow("Smart Glasses - OpenCV Native", frame)
    if cv2.waitKey(1) & 0xFF == ord('q'):
        break

cap.release()
cv2.destroyAllWindows()

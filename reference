while cap.isOpened():
    ret, frame = cap.read()
    if not ret:
        break

    h, w, _ = frame.shape
    detections = []

    # --- FEATURE A: Optical Glint ---
    glints = detect_lens_glint(frame)
    for (gx, gy, gw, gh) in glints:
        cv2.rectangle(frame, (gx, gy), (gx + gw, gy + gh), (0, 255, 255), 2)
        cv2.putText(frame, "GLINT", (gx, gy - 5), cv2.FONT_HERSHEY_SIMPLEX, 0.4, (0, 255, 255), 1)
    if len(glints) > 0:
        detections.append(f"{len(glints)} glint(s)")

    # --- FEATURE B: Object Detection (Cell Phone) ---
    img_obj = cv2.resize(frame, (300, 300))
    input_data_obj = np.expand_dims(img_obj, axis=0).astype(np.uint8)
    obj_interpreter.set_tensor(obj_input[0]['index'], input_data_obj)
    obj_interpreter.invoke()

    boxes = obj_interpreter.get_tensor(obj_output[0]['index'])[0]
    classes = obj_interpreter.get_tensor(obj_output[1]['index'])[0]
    scores = obj_interpreter.get_tensor(obj_output[2]['index'])[0]

    phones_found = 0
    for i in range(len(scores)):
        if scores[i] > 0.5 and int(classes[i]) == CELL_PHONE_CLASS_ID:
            phones_found += 1
            ymin, xmin, ymax, xmax = boxes[i]
            bx, by, bw, bh = int(xmin * w), int(ymin * h), int((xmax - xmin) * w), int((ymax - ymin) * h)
            cv2.rectangle(frame, (bx, by), (bx + bw, by + bh), (0, 255, 0), 2)
            cv2.putText(frame, "CELL PHONE", (bx, by - 5), cv2.FONT_HERSHEY_SIMPLEX, 0.5, (0, 255, 0), 2)
    if phones_found > 0:
        detections.append(f"{phones_found} cell phone(s)")

    # --- FEATURE C: Pose Keypoints (MoveNet) ---
    img_pose = cv2.resize(frame, (192, 192))
    input_data_pose = np.expand_dims(img_pose, axis=0).astype(np.uint8)
    pose_interpreter.set_tensor(pose_input[0]['index'], input_data_pose)
    pose_interpreter.invoke()

    keypoints = pose_interpreter.get_tensor(pose_output[0]['index'])[0][0]
    valid_kps = 0
    for kp in keypoints:
        ky, kx, score = kp
        if score > 0.3:
            valid_kps += 1
            cv2.circle(frame, (int(kx * w), int(ky * h)), 4, (0, 0, 255), -1)
    if valid_kps > 0:
        detections.append(f"Pose ({valid_kps}/17 keypoints)")

    # Print summary to SSH terminal and save annotated frame
    if detections:
        print("Detected: " + " | ".join(detections))
    cv2.imwrite("latest_frame.jpg", frame)

cap.release()

import math
import cv2
import numpy as np
import mediapipe as mp
from mediapipe.tasks import python
from mediapipe.tasks.python import vision

# ---------------------------------------------------------
# 1. Initialize MediaPipe Models (Object + Pose)
# ---------------------------------------------------------
# Models needed (run in terminal if not present):
# wget -O efficientdet.tflite https://storage.googleapis.com/mediapipe-models/object_detector/efficientdet_lite0/float32/1/efficientdet_lite0.tflite
# wget -O pose_landmarker.task https://storage.googleapis.com/mediapipe-models/pose_landmarker/pose_landmarker_lite/float32/1/pose_landmarker_lite.task

# A. Object Detector Setup
obj_base_options = python.BaseOptions(model_asset_path='efficientdet.tflite')
obj_options = vision.ObjectDetectorOptions(
    base_options=obj_base_options,
    score_threshold=0.4
)
detector = vision.ObjectDetector.create_from_options(obj_options)

# B. Pose Detector Setup
pose_base_options = python.BaseOptions(model_asset_path='pose_landmarker.task')
pose_options = vision.PoseLandmarkerOptions(
    base_options=pose_base_options,
    output_segmentation_masks=False
)
pose_landmarker = vision.PoseLandmarker.create_from_options(pose_options)

# ---------------------------------------------------------
# 2. Camera Setup
# ---------------------------------------------------------
cap = cv2.VideoCapture(0)
cap.set(cv2.CAP_PROP_FRAME_WIDTH, 640)
cap.set(cv2.CAP_PROP_FRAME_HEIGHT, 480)

SUSPECT_OBJECTS = ['cell phone', 'camera', 'clock', 'laptop']

def detect_lens_glints(gray_frame):
    """Detects bright circular lens glints caused by optical reflections."""
    _, bright_spots = cv2.threshold(gray_frame, 220, 255, cv2.THRESH_BINARY)
    blurred = cv2.GaussianBlur(bright_spots, (9, 9), 2)
    circles = cv2.HoughCircles(
        blurred, 
        cv2.HOUGH_GRADIENT, 
        dp=1.2, 
        minDist=20, 
        param1=50, 
        param2=15, 
        minRadius=3, 
        maxRadius=25
    )
    return circles

def calculate_angle(a, b, c):
    """Calculates the 2D angle (in degrees) at point B given points A, B, C."""
    ang = math.degrees(math.atan2(c[1]-b[1], c[0]-b[0]) - math.atan2(a[1]-b[1], a[0]-b[0]))
    return abs(ang) if abs(ang) <= 180 else 360 - abs(ang)

while cap.isOpened():
    ret, frame = cap.read()
    if not ret:
        break

    h, w, _ = frame.shape
    gray = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)
    rgb_frame = cv2.cvtColor(frame, cv2.COLOR_BGR2RGB)
    mp_image = mp.Image(image_format=mp.ImageFormat.SRGB, data=rgb_frame)

    # --- A. OPTICAL GLINT DETECTION ---
    circles = detect_lens_glints(gray)
    if circles is not None:
        circles = np.uint16(np.around(circles))
        for i in circles[0, :]:
            cx, cy, radius = i[0], i[1], i[2]
            cv2.circle(frame, (cx, cy), radius + 4, (0, 0, 255), 2)
            cv2.putText(frame, "Glint/Lens?", (cx - 30, cy - 10),
                        cv2.FONT_HERSHEY_SIMPLEX, 0.4, (0, 0, 255), 1)

    # --- B. AI OBJECT DETECTION ---
    detection_result = detector.detect(mp_image)
    detected_phones = []

    for detection in detection_result.detections:
        category = detection.categories[0]
        label_name = category.category_name.lower()
        score = category.score
        bbox = detection.bounding_box

        bx, by, bw, bh = int(bbox.origin_x), int(bbox.origin_y), int(bbox.width), int(bbox.height)
        
        if label_name == 'cell phone':
            detected_phones.append((bx, by, bw, bh))

        if any(obj in label_name for obj in SUSPECT_OBJECTS):
            color = (0, 255, 255) # Yellow box for targets
            display_text = f"TARGET: {category.category_name} ({score:.2f})"
        else:
            color = (0, 255, 0)
            display_text = f"{category.category_name} ({score:.2f})"

        cv2.rectangle(frame, (bx, by), (bx + bw, by + bh), color, 2)
        cv2.putText(frame, display_text, (bx, by - 8),
                    cv2.FONT_HERSHEY_SIMPLEX, 0.5, color, 2)

    # --- C. POSE & RECORDING ANGLE ANALYSIS ---
    pose_result = pose_landmarker.detect(mp_image)
    
    if pose_result.pose_landmarks:
        for pose_landmarks in pose_result.pose_landmarks:
            # Extract key joint coordinates (normalized 0-1 mapped to pixel dimensions)
            def get_coords(idx):
                lm = pose_landmarks[idx]
                return np.array([int(lm.x * w), int(lm.y * h)])

            # Landmarks: 11=L_Shoulder, 12=R_Shoulder, 13=L_Elbow, 14=R_Elbow, 15=L_Wrist, 16=R_Wrist, 0=Nose
            l_shoulder, r_shoulder = get_coords(11), get_coords(12)
            l_elbow, r_elbow = get_coords(13), get_coords(14)
            l_wrist, r_wrist = get_coords(15), get_coords(16)
            nose = get_coords(0)

            # Check angles for both arms (Shoulder -> Elbow -> Wrist)
            l_arm_angle = calculate_angle(l_shoulder, l_elbow, l_wrist)
            r_arm_angle = calculate_angle(r_shoulder, r_elbow, r_wrist)

            # Draw key joints on frame
            for p in [l_wrist, r_wrist, l_elbow, r_elbow, nose]:
                cv2.circle(frame, tuple(p), 4, (255, 0, 0), -1)

            # Rule 1: Arm bent sharply up (wrist near eye level / nose height)
            l_raised = l_wrist[1] < l_shoulder[1] and l_arm_angle < 120
            r_raised = r_wrist[1] < r_shoulder[1] and r_arm_angle < 120

            # Rule 2: Hand is near a detected phone box
            hand_near_phone = False
            for (px, py, pw, ph) in detected_phones:
                for wrist in [l_wrist, r_wrist]:
                    if (px - 30 <= wrist[0] <= px + pw + 30) and (py - 30 <= wrist[1] <= py + ph + 30):
                        hand_near_phone = True

            # Trigger Warning if arm pose matches active recording stance
            if (l_raised or r_raised) and hand_near_phone:
                cv2.putText(frame, "WARNING: SUSPECTED RECORDING POSE", (30, 40),
                            cv2.FONT_HERSHEY_SIMPLEX, 0.6, (0, 0, 255), 2)
            elif l_raised or r_raised:
                cv2.putText(frame, "Hand Raised Near Eye Level", (30, 40),
                            cv2.FONT_HERSHEY_SIMPLEX, 0.5, (0, 255, 255), 1)

    # Show result window
    cv2.imshow("Smart Glasses - Camera & Pose Detector", frame)

    if cv2.waitKey(1) & 0xFF == ord('q'):
        break

cap.release()
cv2.destroyAllWindows()
